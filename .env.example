# ============================================
# APLICAÇÃO
# ============================================
APP_NAME="Loja Online"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
# Gerada por `php artisan key:generate` após instalar o Laravel.
APP_KEY=
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=loja_online
DB_USERNAME=loja_user
DB_PASSWORD=senha_segura
DB_ROOT_PASSWORD=root_senha_segura

# ============================================
# CACHE
# ============================================
# Laravel 11+ lê CACHE_STORE; a antiga CACHE_DRIVER é silenciosamente ignorada.
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# SESSION
# ============================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================
# QUEUE
# ============================================
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================
# MAIL
# ============================================
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="contato@loja.local"
MAIL_FROM_NAME="${APP_NAME}"

# Nota: Em produção, use SMTP real (SendGrid, AWS SES, etc)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.xxxxx

# ============================================
# DOCKER
# ============================================
# Portas mapeadas do Docker (localhost)
DOCKER_HTTP_PORT=80
DOCKER_MYSQL_PORT=3306
DOCKER_PHPMYADMIN_PORT=8081
DOCKER_MAILPIT_PORT=8025
DOCKER_REDIS_PORT=6379

# ============================================
# SEGURANÇA
# ============================================
# Para autenticação Sanctum (API mobile)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_EXPIRATION=43200

# ============================================
# AWS (Opcional - para uploads em produção)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# PAYMENT GATEWAY (Futuro)
# ============================================
# STRIPE_KEY=
# STRIPE_SECRET=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_ACCESS_TOKEN=

# ============================================
# LOG
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# VITE
# ============================================
VITE_APP_NAME="${APP_NAME}"
